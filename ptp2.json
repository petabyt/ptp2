{
  "name": "ptp2-gphoto",
  "isDraft": true,
  "description": "Upstream ptp2 camlib from libgphoto2",
  "author": "Marcus Meissner",
  "license": "LGPL2.0",
  "version": 1,
  "moduleType": "so",
  "modulePath": "libptp2.so",
  "targets": [
    {
      "deviceType": "professional-camera",
      "summary": "Sony mirrorless cameras",
      "company": "Sony",
      "wifiFilters": [{
        "ssidPattern": "DIRECT-.*"
      }],
      "usbFilters": [{
        "vid": "0x054C"
      }]
    },
    {
      "deviceType": "professional-camera",
      "summary": "Nikon DSLRs and mirrorless cameras",
      "company": "Nikon",
      "wifiFilters": [{
        "ssidPattern": "Nikon_.*"
      }],
      "usbFilters": [{
        "vid": "0x04B0"
      }]
    },
    {
      "deviceType": "professional-camera",
      "summary": "Canon DSLRs and mirrorless cameras",
      "company": "Canon",
      "wifiFilters": [
        {"ssidPattern": "EOS.*"},
        {"ssidPattern": "Canon_.*"}
      ],
      "usbFilters": [{
        "vid": "0x04A9"
      }]
    },
    {
      "deviceType": "professional-camera",
      "summary": "Ricoh GR cameras",
      "company": "Ricoh",
      "wifiFilters": [
        {"ssidPattern": "RICOH_.*"},
        {"ssidPattern": "THETA.*"}
      ],
      "usbFilters": [{
        "vid": "0x05CA"
      }]
    },
    {
      "deviceType": "professional-camera",
      "summary": "Olympus / OM System DSLRs and mirrorless cameras",
      "company": "Olympus / OM System",
      "wifiFilters": [{
        "ssidPattern": "OM-.*"
      }],
      "usbFilters": [{
        "vid": "0x07B4"
      }]
    },
    {
      "deviceType": "professional-camera",
      "summary": "Sigma mirrorless cameras",
      "company": "Sigma",
      "usbFilters": [{
        "vid": "0x1003"
      }]
    }
  ]
}
